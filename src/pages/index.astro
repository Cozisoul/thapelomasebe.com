---
import MainLayout from '../layouts/MainLayout.astro';
import content from '../data/content.json';

const { projects } = content;
---

<MainLayout title="Index">
  <div class="pt-32 px-4 lg:px-6 mb-20">
    
    <!-- 1. THE HEADLINE (Editorial/Poetic) -->
    <h1 class="font-sans text-[12vw] leading-[0.8] mb-24 uppercase opacity-90 font-bold">
      Systematic<br>
      <span class="ml-[15vw] italic font-light text-accent-blue">& Poetic</span>
    </h1>

    <!-- THE PROJECT DIRECTORY (INDEX) -->
    <section class="mt-20">
        <h2 class="font-mono text-xs uppercase opacity-50 mb-8 tracking-widest border-b border-system-black/20 pb-2">00.00 // Master Directory</h2>

        <!-- Table Header -->
        <div class="hidden md:grid grid-cols-12 gap-4 font-mono text-xs opacity-50 uppercase tracking-widest mb-4 px-4">
            <div class="col-span-1">ID</div>
            <div class="col-span-4">SYSTEM / REPOSITORY</div>
            <div class="col-span-3">DOMAIN</div>
            <div class="col-span-3">STACK</div>
            <div class="col-span-1 text-right">STATUS</div>
        </div>

        <!-- Table Body (The Projects) -->
        <div class="flex flex-col border-t border-system-black/20">
            
            <!-- PROJECT 1: COSMOS -->
            <a href="https://github.com/Cozisoul/CalibratingTheCosmos-UHF" target="_blank" rel="noopener noreferrer" class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 border-b border-system-black/20 hover:bg-system-black hover:text-cosmic-latte transition-colors group cursor-crosshair">
                <div class="col-span-1 font-mono text-xs opacity-50 group-hover:opacity-100">01</div>
                <div class="col-span-4 font-bold uppercase">Calibrating The Cosmos</div>
                <div class="col-span-3 text-sm opacity-80">Radio Astronomy Pipeline</div>
                <div class="col-span-3 font-mono text-[10px] uppercase">Python, Data Eng</div>
                <div class="col-span-1 text-right font-mono text-xs text-green-500">LIVE</div>
            </a>

            <!-- PROJECT 2: HUGGING FACE -->
            <a href="https://huggingface.co/coziSoul" target="_blank" rel="noopener noreferrer" class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 border-b border-system-black/20 hover:bg-system-black hover:text-cosmic-latte transition-colors group cursor-crosshair">
                <div class="col-span-1 font-mono text-xs opacity-50 group-hover:opacity-100">02</div>
                <div class="col-span-4 font-bold uppercase">Live AI Inference Models</div>
                <div class="col-span-3 text-sm opacity-80">Computer Vision & LLMs</div>
                <div class="col-span-3 font-mono text-[10px] uppercase">Flask, Transformers</div>
                <div class="col-span-1 text-right font-mono text-xs text-green-500">DEPLOYED</div>
            </a>

            <!-- PROJECT 3: CAPTIONING PHOTOS -->
            <a href="https://github.com/Cozisoul/Captioning-Photos-with-Generative-AI" target="_blank" rel="noopener noreferrer" class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 border-b border-system-black/20 hover:bg-system-black hover:text-cosmic-latte transition-colors group cursor-crosshair">
                <div class="col-span-1 font-mono text-xs opacity-50 group-hover:opacity-100">03</div>
                <div class="col-span-4 font-bold uppercase">Captioning Photos with Gen AI</div>
                <div class="col-span-3 text-sm opacity-80">Generative AI Architecture</div>
                <div class="col-span-3 font-mono text-[10px] uppercase">Python, Transformers</div>
                <div class="col-span-1 text-right font-mono text-xs text-green-500">LIVE</div>
            </a>

            <!-- PROJECT 4: TMM-OS -->
            <a href="https://github.com/Cozisoul/tmm-os" target="_blank" rel="noopener noreferrer" class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 border-b border-system-black/20 hover:bg-system-black hover:text-cosmic-latte transition-colors group cursor-crosshair">
                <div class="col-span-1 font-mono text-xs opacity-50 group-hover:opacity-100">04</div>
                <div class="col-span-4 font-bold uppercase">TMM-OS (Project 0723)</div>
                <div class="col-span-3 text-sm opacity-80">Local AI Agent Ecosystem</div>
                <div class="col-span-3 font-mono text-[10px] uppercase">LangGraph, Ollama, Qdrant</div>
                <div class="col-span-1 text-right font-mono text-xs text-accent-blue">RUNTIME</div>
            </a>

            <!-- PROJECT 5: DATA SCIENCE PORTFOLIO -->
            <a href="https://github.com/Cozisoul/DataSciencePortfolio" target="_blank" rel="noopener noreferrer" class="grid grid-cols-1 md:grid-cols-12 gap-4 p-4 border-b border-system-black/20 hover:bg-system-black hover:text-cosmic-latte transition-colors group cursor-crosshair">
                <div class="col-span-1 font-mono text-xs opacity-50 group-hover:opacity-100">05</div>
                <div class="col-span-4 font-bold uppercase">Data Science Portfolio</div>
                <div class="col-span-3 text-sm opacity-80">EDA & Predictive Modeling</div>
                <div class="col-span-3 font-mono text-[10px] uppercase">Python, SQL, Tableau</div>
                <div class="col-span-1 text-right font-mono text-xs text-green-500">ACTIVE</div>
            </a>

        </div>
    </section>

  </div>
</MainLayout>
