---
import MainLayout from '../layouts/MainLayout.astro';
import ArtCanvas from '../components/ArtCanvas.jsx';
import projects from '../data/art_projects.json';
---

<MainLayout title="Art Portfolio">
  {/* Header Section */}
  <div class="fixed top-0 left-0 w-full p-4 md:p-6 pt-20 md:pt-20 pointer-events-none z-30 mix-blend-difference text-cosmic-latte flex justify-end items-start">
    <div class="font-mono text-[10px] md:text-xs uppercase tracking-widest text-right max-w-xs opacity-70">
      00.07 // Transdisciplinary Art<br/>
      <span class="hidden md:inline">Select works spanning painting, photography, and installation.</span>
    </div>
  </div>

  {/* Interactive Canvas */}
  <ArtCanvas client:load projects={projects} />
</MainLayout>
