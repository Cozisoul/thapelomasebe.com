---
import MainLayout from "../../layouts/MainLayout.astro";
import content from "../../data/content.json";

// 1. GENERATE PATHS
export async function getStaticPaths() {
  const { projects } = content;
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<MainLayout title={project.title}>
  <div class="flex flex-col lg:flex-row min-h-screen">
    <!-- LEFT COLUMN: THE LOGIC (Sticky) -->
    <aside
      class="w-full lg:w-1/2 lg:h-screen lg:sticky lg:top-0 p-6 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-system-black bg-cosmic-latte z-10"
    >
      <!-- Top: Header -->
      <div class="mt-24 lg:mt-32">
        <div
          class="font-mono text-xs uppercase tracking-widest opacity-60 mb-4"
        >
          {project.id} — {project.category}
        </div>
        <h1
          class="font-sans font-normal text-6xl lg:text-7xl leading-[0.9] uppercase tracking-tighter mb-8"
        >
          {project.title}
        </h1>

        <!-- The Narrative -->
        <div
          class="font-sans text-lg leading-relaxed max-w-md opacity-90 whitespace-pre-wrap"
        >
          {project.narrative || project.summary}
        </div>
      </div>

      <!-- Bottom: Specs -->
      <div
        class="grid grid-cols-2 gap-8 font-mono text-[10px] uppercase tracking-widest opacity-60 mt-12 lg:mt-0"
      >
        <div>
          <span class="block mb-2 text-accent-blue">[CATEGORY]</span>
          {project.category}
        </div>
        <div>
          <span class="block mb-2 text-accent-blue">[YEAR]</span>
          {project.year}
        </div>
        <div class="col-span-2">
          <span class="block mb-2 text-accent-blue">[TECH / MEDIUM]</span>
          {
            Array.isArray(project.stack)
              ? project.stack.join(" / ")
              : project.stack || "TBD"
          }
        </div>
      </div>
    </aside>

    <!-- RIGHT COLUMN: THE SENSATION (Scroll) -->
    <section
      class="w-full lg:w-1/2 bg-system-black text-cosmic-latte min-h-screen"
    >
      <div class="flex flex-col">
        <!-- Primary Hero Image -->
        <div class="w-full">
          <img
            src={project.hero_image}
            class="w-full h-auto object-cover"
            alt={project.title}
          />
          <div
            class="p-4 font-mono text-[9px] uppercase tracking-widest opacity-50 border-b border-white/20"
          >
            FIG. 01 — HERO VISUAL
          </div>
        </div>

        <!-- Placeholder for "More to come" if empty -->
        <div
          class="h-[50vh] flex items-center justify-center font-mono text-xs opacity-30"
        >
          [ADDITIONAL ASSETS LOADING FROM ARCHIVE...]
        </div>
      </div>
    </section>
  </div>

  <!-- NAVIGATION OVERRIDE -->
  <a
    href="/"
    class="fixed top-6 right-6 font-mono text-xs z-50 mix-blend-difference text-cosmic-latte hover:text-accent-red cursor-pointer"
  >
    [CLOSE]
  </a>
</MainLayout>
