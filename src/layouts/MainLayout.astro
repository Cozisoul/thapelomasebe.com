---
import '../styles/global.css';
import Cursor from '../components/Cursor.jsx';
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | THAPELO MASEBE</title>
  </head>
  <body class="antialiased bg-cosmic-latte text-system-black">
    
    <!-- NOISE OVERLAY (Texture) -->
    <div class="fixed inset-0 pointer-events-none opacity-[0.03] z-50 mix-blend-overlay" 
         style="background-image: url('/noise.png');">
    </div>

    <!-- CUSTOM CURSOR -->
    <Cursor client:load />

    <!-- NAVIGATION (Fixed) -->
    <nav class="fixed top-0 left-0 w-full p-6 flex justify-between z-40 mix-blend-difference text-cosmic-latte">
      <a href="/" class="font-sans font-medium tracking-tight hover:italic transition-all">THAPELO MADIBA MASEBE</a>
      <div class="font-mono text-xs flex gap-4">
        <a href="/">[INDEX]</a>
        <a href="/about">[INFO]</a>
      </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main data-scroll-container>
      <slot />
    </main>

    <!-- SMOOTH SCROLL SCRIPT -->
    <script>
      import Lenis from '@studio-freight/lenis'

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        direction: 'vertical',
        gestureDirection: 'vertical',
        smooth: true,
      })

      function raf(time) {
        lenis.raf(time)
        requestAnimationFrame(raf)
      }

      requestAnimationFrame(raf)
    </script>
  </body>
</html>
