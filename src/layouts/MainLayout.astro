---
import "../styles/global.css";
import Cursor from "../components/Cursor.jsx";
import CookieBanner from "../components/CookieBanner.jsx";
const { title, hideNav } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Security Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://*.googletagmanager.com https://*.google-analytics.com https://tagassistant.google.com; script-src-elem 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://*.googletagmanager.com https://*.google-analytics.com https://tagassistant.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://cdn.simpleicons.org https://logo.clearbit.com https://*.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net; media-src 'self' blob: mediastream:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://stats.g.doubleclick.net https://tagassistant.google.com https://*.googletagmanager.com; font-src 'self' https://fonts.gstatic.com; worker-src 'self' blob:; frame-src 'self' https://*.googletagmanager.com https://tagassistant.google.com;" />
    
    <!-- Google Consent Mode v2 Default -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      
      // Default to denied for GDPR compliance
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });

      // If user previously accepted, update immediately to prevent race conditions
      if (typeof localStorage !== 'undefined') {
        const consent = localStorage.getItem('tmm_cookie_consent');
        if (consent === 'granted') {
          gtag('consent', 'update', {
            'ad_storage': 'granted',
            'analytics_storage': 'granted'
          });
        }
      }
    </script>
    
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-M3TNGW6W');</script>
    <!-- End Google Tag Manager -->
    
    <script is:inline>
      window.gtmPush = function(eventName, payload = {}) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: eventName, ...payload });
      };

      // Extended Tracking Initialization
      window.addEventListener('DOMContentLoaded', () => {
        // 1. Time on Page Engagement Timer (30s)
        setTimeout(() => {
          if (window.gtmPush) window.gtmPush('engagement_timer', { duration: '30s' });
        }, 30000);

        // 2. Global Error Tracking
        window.addEventListener('error', (e) => {
          if (window.gtmPush) window.gtmPush('js_error', { message: e.message, filename: e.filename, lineno: e.lineno });
        });
        window.addEventListener('unhandledrejection', (e) => {
          if (window.gtmPush) window.gtmPush('js_error', { message: e.reason?.toString() || 'Promise Rejection' });
        });

        // 3. Outbound Link Tracking
        document.body.addEventListener('click', (e) => {
          const link = e.target.closest('a');
          if (link && link.href) {
            const isExternal = new URL(link.href).hostname !== window.location.hostname;
            if (isExternal && window.gtmPush) {
              window.gtmPush('outbound_click', { link_url: link.href, link_text: link.textContent.trim() });
            }
          }
        });

        // 4. Basic Scroll Depth Tracking (25%, 50%, 75%, 90%)
        let scrollMarks = { 25: false, 50: false, 75: false, 90: false };
        window.addEventListener('scroll', () => {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight > 0) {
            const scrollPercent = (window.scrollY / docHeight) * 100;
            [25, 50, 75, 90].forEach(mark => {
              if (scrollPercent >= mark && !scrollMarks[mark]) {
                scrollMarks[mark] = true;
                if (window.gtmPush) window.gtmPush('scroll_depth', { depth_percentage: mark });
              }
            });
          }
        }, { passive: true });
      });
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <!-- SEO -->
    <title>{title} | THAPELO MASEBE</title>
    <meta
      name="description"
      content="Thapelo Masebe — Data Scientist & Creative Technologist. Portfolio of work spanning AI, data science, and visual art."
    />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | THAPELO MASEBE`} />
    <meta
      property="og:description"
      content="Data Scientist & Creative Technologist operating at the intersection of data, memory, and emerging African identity."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="/images/og-default.jpg" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | THAPELO MASEBE`} />
    <meta name="twitter:description" content="Data Scientist & Creative Technologist operating at the intersection of data, memory, and emerging African identity." />
    <meta name="twitter:image" content="/images/og-default.jpg" />

    <!-- Schema.org JSON-LD for AI SEO -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Thapelo Masebe",
        "url": "https://thapelomasebe.com",
        "jobTitle": "Data Scientist & Creative Technologist",
        "sameAs": [
          "https://github.com/thapelomasebe",
          "https://linkedin.com/in/thapelo-masebe"
        ],
        "knowsAbout": ["Data Science", "Creative Coding", "Artificial Intelligence", "Generative Art", "Machine Learning"]
      }
    </script>
  </head>
  <body class="antialiased bg-cosmic-latte text-system-black">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M3TNGW6W"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <!-- NOISE OVERLAY (Texture via SVG filter — no external file needed) -->
    <svg aria-hidden="true" class="hidden md:block fixed inset-0 w-full h-full pointer-events-none z-50 mix-blend-overlay opacity-[0.04]" xmlns="http://www.w3.org/2000/svg">
      <filter id="svg-noise-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.80" numOctaves="4" stitchTiles="stitch"/>
      </filter>
      <rect width="100%" height="100%" filter="url(#svg-noise-filter)"/>
    </svg>

    <!-- CUSTOM CURSOR -->
    <Cursor client:load />

    <!-- NAVIGATION (Fixed) -->
    <nav
      class="fixed top-0 left-0 w-full p-4 md:p-6 flex justify-between items-center z-40 mix-blend-difference text-cosmic-latte"
    >
      <a
        href="/"
        class="font-sans font-medium tracking-tight hover:italic transition-all text-sm md:text-base"
        >THAPELO MADIBA MASEBE</a
      >
      {!hideNav && (
        <>
          {/* Desktop Nav */}
          <div class="hidden md:flex font-mono text-xs gap-4 nav-links-desktop">
            <a href="/">[INDEX]</a>
            <a href="/art">[ART]</a>
            <a href="/lab">[LAB]</a>
            <a href="/about">[INFO]</a>
          </div>

          {/* Mobile Hamburger Button */}
          <button
            id="mobile-menu-toggle"
            class="md:hidden font-mono text-xs tracking-widest uppercase p-1"
            aria-label="Open navigation menu"
            aria-expanded="false"
          >
            [MENU]
          </button>
        </>
      )}
    </nav>

    <!-- MOBILE MENU OVERLAY -->
    {!hideNav && (
      <div
        id="mobile-menu-overlay"
        class="fixed inset-0 z-[60] bg-system-black text-cosmic-latte flex flex-col items-center justify-center gap-0 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
      >
        {/* Close Button */}
        <button
          id="mobile-menu-close"
          class="absolute top-4 right-4 font-mono text-xs tracking-widest uppercase p-2 text-cosmic-latte hover:text-accent-red transition-colors"
          aria-label="Close navigation menu"
        >
          [CLOSE]
        </button>

        {/* Menu Links */}
        <a href="/" class="mobile-menu-link font-sans text-4xl font-bold uppercase tracking-tighter py-3 hover:italic hover:text-accent-blue transition-all">[INDEX]</a>
        <a href="/art" class="mobile-menu-link font-sans text-4xl font-bold uppercase tracking-tighter py-3 hover:italic hover:text-accent-blue transition-all">[ART]</a>
        <a href="/lab" class="mobile-menu-link font-sans text-4xl font-bold uppercase tracking-tighter py-3 hover:italic hover:text-accent-blue transition-all">[LAB]</a>
        <a href="/about" class="mobile-menu-link font-sans text-4xl font-bold uppercase tracking-tighter py-3 hover:italic hover:text-accent-blue transition-all">[INFO]</a>

        {/* Bottom identifier */}
        <div class="absolute bottom-8 font-mono text-[10px] uppercase tracking-widest opacity-30">
          THAPELO MADIBA MASEBE — 2025
        </div>
      </div>
    )}

    <!-- PAGE CONTENT -->
    <main data-scroll-container class="safe-bottom">
      <slot />
    </main>

    <CookieBanner client:load />

    <!-- MOBILE MENU SCRIPT -->
    <script>
      const toggle = document.getElementById('mobile-menu-toggle');
      const overlay = document.getElementById('mobile-menu-overlay');
      const closeBtn = document.getElementById('mobile-menu-close');

      if (toggle && overlay && closeBtn) {
        const open = () => {
          overlay.classList.remove('opacity-0', 'pointer-events-none');
          overlay.classList.add('opacity-100', 'pointer-events-auto');
          toggle.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        };

        const close = () => {
          overlay.classList.remove('opacity-100', 'pointer-events-auto');
          overlay.classList.add('opacity-0', 'pointer-events-none');
          toggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        };

        toggle.addEventListener('click', open);
        closeBtn.addEventListener('click', close);

        // Close when clicking a link
        overlay.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', (e) => {
            if ('gtmPush' in window) {
              (window as any).gtmPush('nav_click', { link_text: link.textContent, destination_url: link.href });
            }
            close();
          });
        });
        
        // Track desktop nav clicks
        document.querySelectorAll('.nav-links-desktop a').forEach(link => {
          link.addEventListener('click', (e) => {
            if ('gtmPush' in window) {
              (window as any).gtmPush('nav_click', { link_text: link.textContent, destination_url: (link as HTMLAnchorElement).href });
            }
          });
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && overlay.classList.contains('opacity-100')) {
            close();
          }
        });
      }

      // Track ALL global <a> tag clicks (Outbound and Internal)
      document.body.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const anchor = target.closest('a');
        
        if (anchor && anchor.href && 'gtmPush' in window) {
          const isOutbound = anchor.hostname !== window.location.hostname;
          if (isOutbound) {
            (window as any).gtmPush('outbound_click', { link_url: anchor.href, link_text: anchor.textContent?.trim() || '' });
          }
        }
      });
    </script>

    <!-- SMOOTH SCROLL SCRIPT -->
    <script>
      import Lenis from "@studio-freight/lenis";

      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: "vertical",
        gestureOrientation: "vertical",
        smoothWheel: true,
        touchMultiplier: 2,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>
